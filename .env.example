# Copy this file to .env and fill in exactly one provider. Never needed for
# --dry-run — only IMPLEMENT in a real run reads these.

# Option A: Anthropic (used natively, no HARNESS_MODEL needed unless you
# want to override the default).
ANTHROPIC_API_KEY=

# Option B: OpenRouter — proves the harness doesn't care which model backend
# sits behind IMPLEMENT. If OPENROUTER_API_KEY is set, HARNESS_MODEL is
# required (OpenRouter needs an explicit "<provider>/<model>" slug — see
# https://openrouter.ai/models, e.g. "anthropic/claude-3.5-sonnet" or
# "openai/gpt-4o-mini").
OPENROUTER_API_KEY=
HARNESS_MODEL=
